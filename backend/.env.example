APP_NAME=VendorLens AI API
APP_ENV=development
DATABASE_URL=postgresql+psycopg://vendorlens:vendorlens@localhost:5432/vendorlens
FRONTEND_ORIGIN=http://localhost:5173
UPLOAD_DIR=uploads
CHROMA_PATH=data/chroma
MAX_UPLOAD_SIZE_MB=10
# Keep these false for one-click capstone demo access. Set either flag to true
# and configure that role's credentials to enable its sign-in screen.
REVIEWER_AUTH_ENABLED=false
REVIEWER_EMAIL=
REVIEWER_PASSWORD=
ADMIN_AUTH_ENABLED=false
ADMIN_EMAIL=
ADMIN_PASSWORD=
# OpenRouter takes priority whenever this key is non-empty.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_EXTRACTION_MODEL=openai/gpt-4o-mini
OPENROUTER_ANSWER_MODEL=openai/gpt-4o-mini
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
EXTRACTION_MAX_COMPLETION_TOKENS=4096
# Optional OpenRouter attribution headers.
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME=VendorLens AI
# Azure OpenAI is used only when OPENROUTER_API_KEY is empty.
OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE-NAME.openai.azure.com
AZURE_OPENAI_API_VERSION=2024-10-21
# For Azure, these values must match your deployment names.
OPENAI_EXTRACTION_MODEL=gpt-4o-mini
OPENAI_ANSWER_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Optional Langfuse Cloud tracing. Keep content capture disabled for supplier data.
LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Optional direct project/dashboard link shown only inside the authenticated admin portal.
LANGFUSE_DASHBOARD_URL=
LANGFUSE_CAPTURE_CONTENT=false
# Set this to the deployed commit/tag so dashboard comparisons are release-aware.
LANGFUSE_RELEASE=
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=75
RAG_TOP_K=4
RAG_MAX_DISTANCE=0.72
# Docker Compose sets this to the separate mock ERP MCP service automatically.
# Leave empty for in-process local development and tests.
MOCK_ERP_MCP_URL=
MOCK_ERP_TIMEOUT_SECONDS=8
